/*
  Design tokens Alpha Center / alphaTrack — Tailwind CSS v4 @theme directive.
  Direction : moderne / tech, inspirée des dashboards type Linear, Vercel, et
  des dashboards lime-on-slate récents (fitness/médical premium).
  Sans serif uniquement. Coins arrondis francs. Accent lime électrique.
*/

@theme {
  /* Slate — surfaces sombres (sidebar, hero cards) */
  --color-slate-50: #f8f9fb;
  --color-slate-100: #eff1f5;
  --color-slate-200: #d8dce5;
  --color-slate-300: #b0b7c5;
  --color-slate-400: #7a8298;
  --color-slate-500: #4d566d;
  --color-slate-600: #2e3445;
  --color-slate-700: #1e2230;
  --color-slate-800: #14171f;
  --color-slate-900: #0b0d12;
  --color-slate-950: #050609;

  /* Lime — accent principal (CTA, état actif, badges) */
  --color-lime-50: #f7fde4;
  --color-lime-100: #ecfbb8;
  --color-lime-200: #ddf788;
  --color-lime-300: #cbf558;
  --color-lime-400: #b8ed2c;
  --color-lime-500: #a3d51d;   /* lime principal */
  --color-lime-600: #82ab14;
  --color-lime-700: #5f7e0e;
  --color-lime-800: #44590a;
  --color-lime-900: #2d3d07;

  /* Surface — fonds clairs */
  --color-surface-base: #ffffff;
  --color-surface-muted: #f5f6f8;
  --color-surface-subtle: #ebedf2;
  --color-surface-border: #e3e5eb;

  /* Sémantiques */
  --color-success: #22c55e;
  --color-warning: #f59e0b;
  --color-danger: #ef4444;
  --color-info: #3b82f6;

  /* Typographie — Inter partout + mono pour les IDs */
  --font-sans: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --font-mono: 'JetBrains Mono', 'Geist Mono', ui-monospace, monospace;

  /* Rayons — coins arrondis francs, esthétique 2025 */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --radius-pill: 999px;

  /* Ombres — douces et neutres */
  --shadow-xs: 0 1px 2px rgb(11 13 18 / 0.04);
  --shadow-sm: 0 2px 4px rgb(11 13 18 / 0.06);
  --shadow-md: 0 6px 16px rgb(11 13 18 / 0.08);
  --shadow-lg: 0 16px 40px rgb(11 13 18 / 0.10);
  --shadow-glow-lime: 0 0 0 4px rgb(184 237 44 / 0.22);
}

@layer base {
  html {
    font-family: var(--font-sans);
    font-feature-settings:
      'cv11' on,
      'ss03' on;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    background-color: var(--color-surface-muted);
    color: var(--color-slate-800);
  }

  /* Numérique tabulaire pour KPI et tableaux */
  .tabular {
    font-variant-numeric: tabular-nums;
  }
}
